# Copy to .env.local for local development. Never commit real secrets.

# Public: safe to expose to the browser (inlined at build time).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets: validated in src/env.ts at startup.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=replace-me-with-a-32-plus-character-random-string
CONTACT_INBOX=hello@lumen.example
